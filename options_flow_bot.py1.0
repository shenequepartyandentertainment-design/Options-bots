import os
import time
import logging
import datetime as dt
from concurrent.futures import ThreadPoolExecutor, as_completed
from zoneinfo import ZoneInfo

import pandas as pd
import requests
import yfinance as yf

SCAN_INTERVAL_SEC = 300
SUMMARY_EVERY_MIN = 15
TOP_N = 5
WORKERS = 8
MAX_EXPIRATIONS = 3
MIN_NEW_VOLUME = 1500
MIN_NEW_PREMIUM = 150_000
UNUSUAL_MIN_VOLUME = 1000
UNUSUAL_VOL_OI_RATIO = 3.0
ALERT_COOLDOWN_MIN = 60
TZ = ZoneInfo("America/New_York")

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(message)s")
log = logging.getLogger("flowbot")

state = {}
last_alert = {}
acc = {}  # sym -> [new_call_vol, new_put_vol, new_call_prem, new_put_prem]
totals = {"cv": 0, "pv": 0}


def load_tickers():
    if os.path.exists("tickers.txt"):
        with open("tickers.txt") as f:
            return sorted({l.strip().upper() for l in f if l.strip()})
    try:
        df = pd.read_html("https://en.wikipedia.org/wiki/List_of_S%26P_500_companies")[0]
        return [s.replace(".", "-") for s in df["Symbol"].tolist()]
    except Exception:
        return ["SPY", "QQQ", "AAPL", "MSFT", "NVDA", "TSLA", "AMD", "AMZN", "META", "GOOGL"]


def market_open(now=None):
    now = now or dt.datetime.now(TZ)
    if now.weekday() >= 5:
        return False
    return dt.time(9, 30) <= now.time() <= dt.time(16, 0)


def send_alert(msg):
    log.info("ALERT: %s", msg.replace("\n", " | "))
    hook = os.getenv("DISCORD_WEBHOOK")
    try:
        if hook:
            requests.post(hook, json={"content": msg[:1900]}, timeout=10)
    except Exception as e:
        log.warning("alert send failed: %s", e)


def fmt(n):
    if n >= 1e6:
        return f"${n/1e6:.1f}M"
    if n >= 1e3:
        return f"${n/1e3:.0f}K"
    return f"${n:.0f}"


def pct(x):
    return "n/a" if x is None else f"{x:+.2f}%"


def index_move(sym):
    try:
        t = yf.Ticker(sym)
        d = t.history(period="5d", interval="1d")
        prev = float(d["Close"].iloc[-2])
        last = float(t.history(period="1d", interval="5m")["Close"].iloc[-1])
        return (last / prev - 1) * 100
    except Exception:
        return None


def fetch_flow(sym):
    t = yf.Ticker(sym)
    exps = t.options[:MAX_EXPIRATIONS]
    out = {"cv": 0, "pv": 0, "cp": 0.0, "pp": 0.0, "unusual": []}
    for exp in exps:
        ch = t.option_chain(exp)
        for side, df in (("CALL", ch.calls), ("PUT", ch.puts)):
            df = df.fillna(0)
            vol = df["volume"]
            prem = (vol * df["lastPrice"] * 100).sum()
            if side == "CALL":
                out["cv"] += int(vol.sum()); out["cp"] += prem
            else:
                out["pv"] += int(vol.sum()); out["pp"] += prem
            hot = df[(vol >= UNUSUAL_MIN_VOLUME) &
                     (vol >= UNUSUAL_VOL_OI_RATIO * df["openInterest"].clip(lower=1))]
            for _, r in hot.iterrows():
                out["unusual"].append(
                    f"{side} {r['strike']:g} {exp} vol {int(r['volume']):,} "
                    f"OI {int(r['openInterest']):,}")
    return out


def cooled(sym, kind):
    now = dt.datetime.now()
    prev = last_alert.get((sym, kind))
    if prev and (now - prev).total_seconds() < ALERT_COOLDOWN_MIN * 60:
        return False
    last_alert[(sym, kind)] = now
    return True


def evaluate(sym, cur):
    prev = state.get(sym)
    state[sym] = cur
    alerts = []
    if prev:
        dcv = max(cur["cv"] - prev["cv"], 0)
        dpv = max(cur["pv"] - prev["pv"], 0)
        dcp = max(cur["cp"] - prev["cp"], 0)
        dpp = max(cur["pp"] - prev["pp"], 0)
        a = acc.setdefault(sym, [0, 0, 0.0, 0.0])
        a[0] += dcv; a[1] += dpv; a[2] += dcp; a[3] += dpp
        if dcv >= MIN_NEW_VOLUME and dcp >= MIN_NEW_PREMIUM and cooled(sym, "calls"):
            alerts.append(f"🟢 BIG CALLS {sym}: +{dcv:,} contracts ({fmt(dcp)})")
        if dpv >= MIN_NEW_VOLUME and dpp >= MIN_NEW_PREMIUM and cooled(sym, "puts"):
            alerts.append(f"🔴 BIG PUTS {sym}: +{dpv:,} contracts ({fmt(dpp)})")
    if cur["unusual"] and cooled(sym, "unusual"):
        alerts.append(f"🔥 UNUSUAL {sym}\n" + "\n".join(cur["unusual"][:5]))
    return alerts


def send_summary(title="📊 MARKET UPDATE"):
    spy, qqq = index_move("SPY"), index_move("QQQ")
    moves = [m for m in (spy, qqq) if m is not None]
    move = sum(moves) / len(moves) if moves else 0.0

    tcp = sum(v[2] for v in acc.values())
    tpp = sum(v[3] for v in acc.values())
    bias = (tcp - tpp) / max(tcp + tpp, 1)
    cv_all = sum(s["cv"] for s in state.values())
    pv_all = sum(s["pv"] for s in state.values())
    pc = pv_all / max(cv_all, 1)

    if move > 0.15 and bias > 0.05:
        verdict = "🟢 MARKET UP, bullish option flow"
    elif move < -0.15 and bias < -0.05:
        verdict = "🔴 MARKET DOWN, bearish option flow"
    elif move > 0.15:
        verdict = "🟢 MARKET UP (flow mixed)"
    elif move < -0.15:
        verdict = "🔴 MARKET DOWN (flow mixed)"
    else:
        verdict = "🟡 FLAT / MIXED"

    now = dt.datetime.now(TZ).strftime("%I:%M %p ET")
    lines = [f"{title} {now}", verdict,
             f"SPY {pct(spy)} | QQQ {pct(qqq)}",
             f"New flow: calls {fmt(tcp)} vs puts {fmt(tpp)}",
             f"Put/Call volume ratio today: {pc:.2f}", ""]

    top_c = sorted(acc.items(), key=lambda kv: kv[1][2], reverse=True)[:TOP_N]
    top_p = sorted(acc.items(), key=lambda kv: kv[1][3], reverse=True)[:TOP_N]
    lines.append("🟢 Top call flow:")
    lines += [f"{s} {fmt(v[2])} ({v[0]:,})" for s, v in top_c if v[2] > 0] or ["none yet"]
    lines.append("")
    lines.append("🔴 Top put flow:")
    lines += [f"{s} {fmt(v[3])} ({v[1]:,})" for s, v in top_p if v[3] > 0] or ["none yet"]
    send_alert("\n".join(lines))
    acc.clear()


def scan_once(tickers):
    n_alerts = 0
    with ThreadPoolExecutor(max_workers=WORKERS) as ex:
        futs = {ex.submit(fetch_flow, s): s for s in tickers}
        for f in as_completed(futs):
            sym = futs[f]
            try:
                for a in evaluate(sym, f.result()):
                    send_alert(a); n_alerts += 1
            except Exception as e:
                log.debug("%s skipped: %s", sym, e)
    return n_alerts


def main():
    tickers = load_tickers()
    log.info("Loaded %d tickers", len(tickers))
    send_alert(f"✅ Options flow bot started, watching {len(tickers)} tickers")
    last_summary = time.time()
    while True:
        try:
            if market_open():
                start = time.time()
                n = scan_once(tickers)
                log.info("Pass done in %.0fs, %d alerts", time.time() - start, n)
                if time.time() - last_summary >= SUMMARY_EVERY_MIN * 60:
                    send_summary()
                    last_summary = time.time()
                time.sleep(SCAN_INTERVAL_SEC)
            else:
                if os.getenv("EXIT_AT_CLOSE") and state:
                    send_summary("🔔 CLOSING SUMMARY")
                    log.info("Market closed, exiting")
                    break
                state.clear()
                log.info("Market closed, sleeping")
                time.sleep(60)
        except KeyboardInterrupt:
            break
        except Exception as e:
            log.error("loop error: %s", e)
            time.sleep(60)


if __name__ == "__main__":
    main()
